    "password.explain": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server refused this login. Enter the password for this repository. It is saved in the Keychain, then the operation is tried again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器拒绝了这次登录。请输入这个仓库的密码。密码会存入钥匙串，然后自动再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器拒絕了這次登入。請輸入這個倉庫的密碼。密碼會存入鑰匙圈，然後自動再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーがログインを拒否しました。このリポジトリのパスワードを入力してください。キーチェーンに保存し、もう一度試します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 로그인을 거부했습니다. 이 저장소의 암호를 입력하세요. 키체인에 저장한 뒤 다시 시도합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat die Anmeldung abgelehnt. Geben Sie das Passwort für dieses Archiv ein. Es wird im Schlüsselbund gesichert und der Vorgang erneut versucht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a refusé la connexion. Saisissez le mot de passe de ce dépôt. Il est enregistré dans le trousseau, puis l’opération est relancée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor rechazó el inicio de sesión. Introduce la contraseña de este repositorio. Se guarda en el llavero y se reintenta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ha rifiutato l’accesso. Inserisci la password di questo repository. Viene salvata nel portachiavi e l’operazione viene ripetuta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor recusou o início de sessão. Introduza a palavra-passe deste repositório. É guardada nas chaves e a operação é repetida."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server weigerde deze aanmelding. Voer het wachtwoord van deze repository in. Het wordt in de sleutelhanger bewaard en de actie wordt opnieuw geprobeerd."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Servern nekade inloggningen. Ange lösenordet för det här arkivet. Det sparas i nyckelringen och försöket görs om."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren afviste login. Indtast adgangskoden til dette lager. Den gemmes i nøgleringen, og handlingen prøves igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren avslo innloggingen. Skriv inn passordet for dette depotet. Det lagres i nøkkelringen, og forsøket gjentas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelin hylkäsi kirjautumisen. Anna tämän tietovaraston salasana. Se tallennetaan avainnippuun ja toiminto yritetään uudelleen."
          }
        }
      }
    },
